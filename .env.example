# ═══════════════════════════════════════════════════════════════════════════
# Vanmoer Platform — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed — this file (.env.example) is the one that is.
# ═══════════════════════════════════════════════════════════════════════════

# ── Gemini (Google Generative AI) ────────────────────────────────────────────
# Used for LLM document extraction (helpers/gemini_client.py, and directly in
# clients/carpenter/inbound/arrival_notice.py + scanned_doc.py).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# JWT_SECRET signs every login token (helpers/jwt_utils.py). Use a long random
# string in any real environment — the app falls back to an insecure default
# if this is unset, which is only acceptable for local scratch testing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=12

# ── Server ───────────────────────────────────────────────────────────────────
# FLASK_DEBUG=1 runs Werkzeug's dev server + reloader (LAN-reachable on
# 0.0.0.0). Set to 0 for a real deployment — main.py then serves through
# waitress (a proper multi-threaded WSGI server) instead.
FLASK_DEBUG=1
PORT=5000
# Only used when FLASK_DEBUG=0 (waitress worker thread count).
WAITRESS_THREADS=16

# ── Backups ──────────────────────────────────────────────────────────────────
# How often database/backup.py's scheduled job snapshots app.db -> app_backup.db,
# then uploads both to Google Drive (database/drive_sync.py), overwriting the
# same two Drive files in place each run. Drive upload requires credentials.json
# (OAuth client secret) and a one-time `python -m database.drive_auth` to create
# token.json — see database/drive_auth.py.
BACKUP_INTERVAL_HOURS=1

# ── Database (optional overrides) ───────────────────────────────────────────
# Only needed if you want the SQLite files somewhere other than database/.
# Leave unset to use the defaults: database/app.db and database/app_backup.db.
# DATABASE_PATH=database/app.db
# DATABASE_BACKUP_PATH=database/app_backup.db

# ── ITOS screenshot automation (helpers/itos_automation.py) ────────────────
# Drives an on-screen Edge window inside a Windows 365 remote session to
# screenshot iTOS orders — only runs on Windows, with a real desktop session
# available. Screen coordinates (APPS_TAB_X/Y, CARD_X/Y) are specific to the
# machine's monitor layout; re-measure them if this ever moves to another PC.
# Leave unset to use the defaults baked into itos_automation.py.
# ITOS_TARGET_URL=https://itos.vanmoer.com
# ITOS_INDEX_URL=https://itos.vanmoer.com/Stevedoring/Order/Index
# ITOS_APP_ID=MicrosoftCorporationII.Windows365_8wekyb3d8bbwe!Windows365
# ITOS_APPS_TAB_X=301
# ITOS_APPS_TAB_Y=347
# ITOS_CARD_X=410
# ITOS_CARD_Y=457
# ITOS_MAX_LAUNCH_RETRIES=3
# How often the single background worker (helpers/screenshot_worker.py)
# polls the queue for the next job when idle.
# SCREENSHOT_POLL_SECONDS=3
